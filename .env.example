# .env 로 복사해서 사용합니다 (make env). .env 는 Git 에서 제외되며 권한은 600 입니다.
# 아래 값은 데모 기본값입니다. 실제 환경에서는 실제 값으로 바꾸고 절대 커밋하지 마세요.

# --- NetBox API
NETBOX_URL=https://127.0.0.1
NETBOX_TOKEN=                 # 읽기 전용 토큰: MCP, dry-run, dynamic inventory (make netbox-init 이 채움)
NETBOX_WRITE_TOKEN=           # 쓰기 토큰: --apply, bootstrap 전용 (make netbox-init 이 채움)
NETBOX_VERIFY_TLS=true
NETBOX_CA_BUNDLE=/opt/netbox-docker/proxy/certs/netbox.crt   # 배포 시 만든 자체 서명 인증서
NETBOX_API=${NETBOX_URL}      # dynamic inventory 플러그인이 읽는 변수

# --- BMC (Redfish GET 전용 / ipmitool 읽기 전용)
BMC_USERNAME=demo             # 데모: 가짜 BMC(demo/mock_bmc) 계정
BMC_PASSWORD=demo-password    # 데모 전용 가짜 비밀번호
BMC_VERIFY_TLS=pin            # true | false | pin (pin: assetctl.py bmc-trust 로 기록한 인증서 지문만 허용)
#BMC_CA_BUNDLE=/etc/pki/tls/certs/bmc-ca.pem

# --- OS 수집 (실제 환경에서는 Ansible Vault 권장: inventory/group_vars/all/vault.yml)
LINUX_SSH_USER=
LINUX_SSH_KEY_FILE=~/.ssh/id_asset_sync
WINRM_USER=
WINRM_PASSWORD=
#ANSIBLE_VAULT_PASSWORD_FILE=~/.ansible/asset-sync.vault_pass

# --- netbox-docker 배포 (scripts/deploy_netbox.sh)
NETBOX_DOCKER_VERSION=5.1.1
NETBOX_DOCKER_DIR=/opt/netbox-docker
NETBOX_PUBLIC_IP=127.0.0.1    # nginx TLS 프록시가 80/443 을 여는 주소. VM IP 로 바꾸면 다른 PC 에서 접속 가능
NETBOX_PORT=8000              # 127.0.0.1 전용 평문 포트 (헬스체크용)
NETBOX_GRANIAN_WORKERS=4      # 개인 VM(4GB 내외) 기준. 코어가 많으면 늘리세요
NETBOX_PG_SHARED_BUFFERS=512MB
NETBOX_PG_EFFECTIVE_CACHE=1536MB
NETBOX_BACKUP_DIR=/var/backups/netbox
NETBOX_BACKUP_KEEP_DAYS=14

# --- 입력 / 주기 실행
ASSET_SYNC_EXCEL_FILE=demo/data/demo_assets.xlsx   # 엑셀 입력 (비우면 hosts 파일 사용)
ASSET_SYNC_EXCEL_SITE=           # 비우면 config/settings.yml 의 excel.sheets (IDC별 시트 -> 사이트) 사용
ASSET_SYNC_HOSTS_FILE=inventory/hosts_input/hosts
ASSET_SYNC_AUTO_APPLY=false   # true 면 타이머가 high 신뢰도 변경을 반영 (max_hosts 상한은 그대로)
ASSET_SYNC_MAX_HOSTS=5
